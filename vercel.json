{
  "version": 2,
  "builds": [
    { "src": "api/index.js", "use": "@vercel/node" },
    { "src": "*.html", "use": "@vercel/static" },
    { "src": "emiliana.css", "use": "@vercel/static" },
    { "src": "package.json", "use": "@vercel/static" },
    { "src": "assets/**", "use": "@vercel/static" },
    { "src": "firebase-config.js", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "src": "/app/admin", "dest": "/emiliana-admin.html" },
    { "src": "/admin", "dest": "/emiliana-admin.html" },
    { "src": "/app/chat", "dest": "/emiliana-chat.html" },
    { "src": "/chat", "dest": "/emiliana-chat.html" },
    { "src": "/app/login", "dest": "/emiliana-login.html" },
    { "src": "/login", "dest": "/emiliana-login.html" },
    { "src": "/app/about", "dest": "/emiliana-about.html" },
    { "src": "/about", "dest": "/emiliana-about.html" },
    { "src": "/app/companions", "dest": "/emiliana-companions.html" },
    { "src": "/compagnons", "dest": "/emiliana-companions.html" },
    { "src": "/app/account", "dest": "/emiliana-account.html" },
    { "src": "/compte", "dest": "/emiliana-account.html" },
    { "src": "/landing", "dest": "/emiliana-landing.html" },
    { "src": "/", "dest": "/emiliana-landing.html" },
    { "src": "/users.json", "status": 404 },
    { "src": "/messages.json", "status": 404 },
    { "src": "/(.*)", "dest": "/$1" }
  ],
  "env": { "NODE_ENV": "production" }
}
