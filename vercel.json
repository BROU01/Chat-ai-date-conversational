{
  "version": 2,
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.js" },
    { "source": "/app/admin", "destination": "/emiliana-admin.html" },
    { "source": "/admin", "destination": "/emiliana-admin.html" },
    { "source": "/app/chat", "destination": "/emiliana-chat.html" },
    { "source": "/chat", "destination": "/emiliana-chat.html" },
    { "source": "/app/login", "destination": "/emiliana-login.html" },
    { "source": "/login", "destination": "/emiliana-login.html" },
    { "source": "/app/about", "destination": "/emiliana-about.html" },
    { "source": "/about", "destination": "/emiliana-about.html" },
    { "source": "/app/companions", "destination": "/emiliana-companions.html" },
    { "source": "/compagnons", "destination": "/emiliana-companions.html" },
    { "source": "/app/account", "destination": "/emiliana-account.html" },
    { "source": "/compte", "destination": "/emiliana-account.html" },
    { "source": "/landing", "destination": "/emiliana-landing.html" },
    { "source": "/", "destination": "/emiliana-landing.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
